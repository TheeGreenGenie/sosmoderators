# Local development only — never commit .env
# Devvit production secrets use: devvit settings set <key> <value>

# Only needed if running local test scripts that hit an LLM API directly
# In production, set this via: devvit settings set LLM_API_KEY <your-key>
LLM_API_KEY=

# Optional: override LLM endpoint for local testing
LLM_API_ENDPOINT=
